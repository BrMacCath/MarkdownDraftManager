{
  "name": "markdown-draft-manager",
  "displayName": "Markdown Draft Manager",
  "description": "Creates new drafts from markdown files",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdown-draft-manager.updateMarkdownDraft",
        "title": "Update Markdown Draft"
      }
    ],
    "configuration": [
      {
        "title": "Frontmatter",
        "order": 1,
        "properties": {
          "myExtension.frontmatter.draftNumIndicator": {
            "type": "string",
            "default": "draftNum",
            "description": "Frontmatter key used to track the draft number."
          },
          "myExtension.frontmatter.draftStyleIndicator": {
            "type": "string",
            "default": "draftStyle",
            "description": "Frontmatter key used to record the draft style."
          },
          "myExtension.frontmatter.completeSectionIndicator": {
            "type": "string",
            "default": "completeSection",
            "description": "Heading for the complete section in the draft."
          }
        }
      },
      {
        "title": "Draft Style",
        "order": 2,
        "properties": {
          "myExtension.draftStyle.style": {
            "type": "string",
            "default": "Peterson",
            "editPresentation": "multilineText",
            "description": "Describe the style you want drafts written in."
          },
          "myExtension.draftStyle.paragraphSeparator": {
            "type": "string",
            "default": "+---+",
            "editPresentation": "multilineText",
            "description": "How do you want the draft paragraphs separated?"
          },
          "myExtension.draftStyle.haveTopicFrontmatterSeparator": {
            "type": "boolean",
            "default": true,
            "editPresentation": "multilineText",
            "description": "How do you want the topic frontmatter separated?"
          },
          "myExtension.draftStyle.topicFrontmatterSeparator": {
            "type": "string",
            "default": "*---*",
            "editPresentation": "multilineText",
            "description": "How do you want the topic frontmatter separated?"
          },
          "myExtension.draftStyle.haveLineComments": {
            "type": "boolean",
            "default": true,
            "editPresentation": "multilineText",
            "description": "Do you want line comments?"
          },
          "myExtension.draftStyle.commentSignifier": {
            "type": "string",
            "default": "*",
            "editPresentation": "multilineText",
            "description": "How do you want to signify a comment line?"
          },
          "myExtension.draftStyle.rewriteLineSignifier": {
            "type": "string",
            "default": ">",
            "editPresentation": "multilineText",
            "description": "How do you want to signify a line to rewrite?"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test --coverage --coverage-reporter lcov --coverage-reporter text"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
